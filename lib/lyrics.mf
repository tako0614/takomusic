export fn hiragana(text) {
  return {
    kind: "syllable",
    alphabet: "Hiragana",
    text: text
  };
}

export fn katakana(text) {
  return {
    kind: "syllable",
    alphabet: "Katakana",
    text: text
  };
}

// ============================================
// Hangul (Korean)
// ============================================

export fn hangul(text) {
