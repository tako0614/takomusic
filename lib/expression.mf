import * as core from "std:core";
import * as curves from "std:curves";

export fn vibrato(start, end, depth, rate, shape) {
  let shapeVal = shape;
  if (shapeVal == null) {
    shapeVal = "sine";
  }
  let events = [];
  events[events.length] = { type: "automation", param: "vibratoDepth", start: start, end: end, curve: curves.linear(depth, depth) };
  events[events.length] = { type: "automation", param: "vibratoRate", start: start, end: end, curve: curves.linear(rate, rate) };
  events[events.length] = { type: "control", start: start, kind: "vibratoShape", data: { shape: shapeVal } };
  return { events: events, length: end };
}

export fn vibratoDelayed(start, end, depth, rate, delay) {
  let events = [];
  const onsetEnd = start + delay;
  events[events.length] = { type: "automation", param: "vibratoDepth", start: start, end: onsetEnd, curve: curves.linear(0, 0) };
  events[events.length] = { type: "automation", param: "vibratoDepth", start: onsetEnd, end: end, curve: curves.easeIn(0, depth) };
  events[events.length] = { type: "automation", param: "vibratoRate", start: start, end: end, curve: curves.linear(rate, rate) };
  return { events: events, length: end };
}

export fn vibratoContour(start, end, depthCurve, rate) {
  let events = [];
  events[events.length] = { type: "automation", param: "vibratoDepth", start: start, end: end, curve: depthCurve };
  events[events.length] = { type: "automation", param: "vibratoRate", start: start, end: end, curve: curves.linear(rate, rate) };
  return { events: events, length: end };
}

export fn wideVibrato(start, end) {
  return vibrato(start, end, 0.8, 5.5, "sine");
}

export fn narrowVibrato(start, end) {
  return vibrato(start, end, 0.3, 7, "sine");
}

export fn nonVibrato(start, end) {
  return { type: "automation", param: "vibratoDepth", start: start, end: end, curve: curves.linear(0, 0) };
}

export fn bowPressure(start, end, fromPressure, toPressure) {
  return { type: "automation", param: "bowPressure", start: start, end: end, curve: curves.linear(fromPressure, toPressure) };
}

export fn bowSpeed(start, end, fromSpeed, toSpeed) {
  return { type: "automation", param: "bowSpeed", start: start, end: end, curve: curves.linear(fromSpeed, toSpeed) };
}

export fn bowPosition(start, end, fromPos, toPos) {
  return { type: "automation", param: "bowPosition", start: start, end: end, curve: curves.linear(fromPos, toPos) };
}

export fn sulTasto(start, end) {
  return bowPosition(start, end, 0, 0);
}

export fn sulPonticello(start, end) {
  return bowPosition(start, end, 1, 1);
}

export fn ordinario(start, end) {
  return bowPosition(start, end, 0.5, 0.5);
}

export fn bowDown(pos) {
  return { type: "control", start: pos, kind: "bowDirection", data: { direction: "down" } };
}

export fn bowUp(pos) {
  return { type: "control", start: pos, kind: "bowDirection", data: { direction: "up" } };
}

export fn colLegno(pos, colType) {
  let cType = colType;
  if (cType == null) {
    cType = "battuto";
  }
  return { type: "control", start: pos, kind: "colLegno", data: { type: cType } };
}

export fn flautando(start, end) {
  let events = [];
  events[events.length] = bowPosition(start, end, 0.15, 0.15);
  events[events.length] = bowPressure(start, end, 0.3, 0.3);
  return { events: events, length: end };
}

export fn portamento(start, end, fromPitch, toPitch, slideTime) {
  let slideT = slideTime;
  if (slideT == null) {
    slideT = end - start;
  }
  return { type: "glissando", start: start, end: start + slideT, fromPitch: fromPitch, toPitch: toPitch, style: "continuous", ext: { portamento: true } };
}

export fn portamentoTimed(start, end, fromPitch, toPitch, timing, slideDuration) {
  let slideStart = start;
  let slideEnd = end;
  if (timing == "early") {
    slideEnd = start + slideDuration;
  } else if (timing == "late") {
    slideStart = end - slideDuration;
  }
  return { type: "glissando", start: slideStart, end: slideEnd, fromPitch: fromPitch, toPitch: toPitch, style: "continuous", ext: { portamento: true, timing: timing } };
}

export fn airPressure(start, end, fromPressure, toPressure) {
  return { type: "automation", param: "airPressure", start: start, end: end, curve: curves.linear(fromPressure, toPressure) };
}

export fn airSpeed(start, end, fromSpeed, toSpeed) {
  return { type: "automation", param: "airSpeed", start: start, end: end, curve: curves.linear(fromSpeed, toSpeed) };
}

export fn embouchure(start, end, fromTight, toTight) {
  return { type: "automation", param: "embouchure", start: start, end: end, curve: curves.linear(fromTight, toTight) };
}

export fn breathiness(start, end, fromBreath, toBreath) {
  return { type: "automation", param: "breathiness", start: start, end: end, curve: curves.linear(fromBreath, toBreath) };
}

export fn multiphonic(start, dur, pitches, fingering) {
  let events = [];
  for (pitch in pitches) {
    events[events.length] = { type: "note", start: start, dur: dur, pitch: pitch, velocity: 0.7, techniques: ["multiphonic"], ext: { fingering: fingering } };
  }
  return { events: events, length: start + dur };
}

export fn keyClicks(start, dur, pattern) {
  return { type: "note", start: start, dur: dur, pitch: 0, velocity: 0.5, techniques: ["keyClicks"], ext: { pattern: pattern } };
}

export fn airSound(start, dur, intensity) {
  return { type: "note", start: start, dur: dur, pitch: 0, velocity: intensity, techniques: ["airSound"] };
}

export fn tongueRam(start, dur) {
  return { type: "note", start: start, dur: dur, pitch: 0, velocity: 0.9, techniques: ["tongueRam"] };
}

export fn flutterTongue(start, end, rate) {
  let events = [];
  events[events.length] = { type: "control", start: start, kind: "flutterTongue", data: { enabled: true, rate: rate } };
  events[events.length] = { type: "control", start: end, kind: "flutterTongue", data: { enabled: false } };
  return { events: events, length: end };
}

export fn growl(start, end, intensity) {
  return { type: "automation", param: "growl", start: start, end: end, curve: curves.linear(intensity, intensity) };
}

export fn subtone(start, end) {
  return { type: "automation", param: "subtone", start: start, end: end, curve: curves.linear(1, 1) };
}

export fn behindBridge(start, dur) {
  return { type: "note", start: start, dur: dur, pitch: 0, velocity: 0.6, techniques: ["behindBridge"] };
}

export fn bartokPizz(start, dur, pitch) {
  return { type: "note", start: start, dur: dur, pitch: pitch, velocity: 0.95, techniques: ["bartokPizz"] };
}

export fn leftHandPizz(start, dur, pitch) {
  return { type: "note", start: start, dur: dur, pitch: pitch, velocity: 0.6, techniques: ["leftHandPizz"] };
}

export fn tremoloSpeed(start, end, fromSpeed, toSpeed) {
  return { type: "automation", param: "tremoloSpeed", start: start, end: end, curve: curves.linear(fromSpeed, toSpeed) };
}

export fn jete(start, dur, numBounces) {
  return { type: "control", start: start, kind: "jete", data: { bounces: numBounces, duration: dur } };
}

export fn preparedPiano(pos, preparation) {
  return { type: "control", start: pos, kind: "preparation", data: preparation };
}

export fn stringMute(pos, strings, material) {
  return preparedPiano(pos, { type: "mute", strings: strings, material: material });
}

export fn pizzicatoInside(start, dur, pitch) {
  return { type: "note", start: start, dur: dur, pitch: pitch, velocity: 0.7, techniques: ["pizzicatoInside"] };
}

export fn pianoHarmonic(start, dur, pitch, node) {
  return { type: "note", start: start, dur: dur, pitch: pitch, velocity: 0.5, techniques: ["harmonic"], ext: { node: node } };
}

export fn sprechstimme(note) {
  let newNote = core.cloneEvent(note);
  if (newNote.techniques == null) {
    newNote.techniques = [];
  }
  newNote.techniques[newNote.techniques.length] = "sprechstimme";
  return newNote;
}

export fn falsetto(start, end) {
  return { type: "control", start: start, kind: "vocalRegister", data: { register: "falsetto" } };
}

export fn chestVoice(start, end) {
  return { type: "control", start: start, kind: "vocalRegister", data: { register: "chest" } };
}

export fn headVoice(start, end) {
  return { type: "control", start: start, kind: "vocalRegister", data: { register: "head" } };
}

export fn belt(start, end) {
  return { type: "control", start: start, kind: "vocalRegister", data: { register: "belt" } };
}

export fn vocalFry(start, end) {
  return { type: "automation", param: "vocalFry", start: start, end: end, curve: curves.linear(1, 1) };
}

export fn timing(note, offset) {
  let newNote = core.cloneEvent(note);
  if (newNote.ext == null) {
    newNote.ext = {};
  }
  newNote.ext.timingOffset = offset;
  return newNote;
}

export fn rush(note, amount) {
  let amt = amount;
  if (amt == null) {
    amt = -0.02;
  }
  return timing(note, amt);
}

export fn layBack(note, amount) {
  let amt = amount;
  if (amt == null) {
    amt = 0.03;
  }
  return timing(note, amt);
}
