export fn main() -> Score {
  const tempo = 120;
  let bpm = 100bpm;
  if (tempo > 100) {
    bpm = 140bpm;
  } else {
    bpm = 100bpm;
  }
  return score {
    tempo { 1:1 -> bpm; }
    meter { 1:1 -> 4/4; }
    sound "test" kind instrument { label "Test"; }
    track "Test" role Instrument sound "test" {}
  };
}
